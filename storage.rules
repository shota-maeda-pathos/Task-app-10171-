rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // タスク添付ファイル: ログイン済みユーザーのみ読み書き可
    match /task-attachments/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024;  // 10MB上限
    }
  }
}
