[debug] [2026-10-05T09:14:21.244Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kensyu10171/rulesets {"name":"projects/kensyu10171/rulesets/36e44015-191b-4edd-a732-ad37aa2e609b","source":{"files":[{"content":"rules_version = '2';\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\n    function isActiveMember() {\n      return request.auth != null\n        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.get('disabled', false) == false;\n    }\n    // New uploads are scoped to their author's UID. Overwriting is prohibited.\n    match /task-attachments/{taskId}/{authorId}/{fileName} {\n      allow read: if isActiveMember();\n      allow create: if isActiveMember() && request.auth.uid == authorId\n        && firestore.exists(/databases/(default)/documents/tasks/$(taskId))\n        && request.resource.size <= 10 * 1024 * 1024;\n      allow delete: if isActiveMember() && request.auth.uid == authorId;\n    }\n    // Existing flat paths use an owner claim validated by Firestore rules.\n    match /task-attachments/{taskId}/{fileName} {\n      allow read: if isActiveMember();\n      allow delete: if isActiveMember()\n        && firestore.get(/databases/(default)/documents/tasks/$(taskId)/attachmentOwners/$(fileName)).data.authorId == request.auth.uid;\n    }\r\n  }\r\n}\r\n","name":"storage.rules"}]},"createTime":"2026-10-05T09:14:21.374879Z","metadata":{"services":["firebase.storage"]}}
