[debug] [2026-10-05T09:14:23.949Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kensyu10171/rulesets {"name":"projects/kensyu10171/rulesets/5eecd164-c091-4227-b60e-ac9d8b5df2ed","source":{"files":[{"content":"rules_version = '2';\n// Members: immutable uid; role is member/manager; disabled is an optional bool.\n// Tasks/templates: immutable createdBy. Recurrence copies validate their predecessor.\n// Nonmembers and disabled accounts may only get their own onboarding/status record.\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isActiveMember() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/members/$(request.auth.uid))\n        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('disabled', false) == false;\n    }\n\r\n    function isManager() {\n      return isActiveMember()\n        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'manager';\n    }\n\n    function validUid(value) {\n      return value is string && value.size() > 0 && value.size() <= 128;\n    }\n\n    function isValidMember(data) {\n      return data.keys().hasAll(['uid', 'name', 'role', 'weeklyCapacityHours', 'avatarColor'])\n        && data.keys().hasOnly(['uid', 'name', 'role', 'weeklyCapacityHours', 'avatarColor', 'disabled', 'theme', 'displayName', 'photoURL', 'fcmToken', 'leaves', 'weeklyCapacity'])\n        && validUid(data.uid)\n        && data.name is string && data.name.size() > 0 && data.name.size() <= 256\n        && data.role in ['member', 'manager']\n        && data.weeklyCapacityHours is number && data.weeklyCapacityHours > 0 && data.weeklyCapacityHours <= 168\n        && data.avatarColor is string && data.avatarColor.size() <= 64\n        && data.get('disabled', false) is bool\n        && (!('theme' in data) || (data.theme is string && data.theme.size() <= 64))\n        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))\n        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 4096))\n        && (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 4096))\n        && (!('leaves' in data) || (data.leaves is list && data.leaves.size() <= 2000))\n        && (!('weeklyCapacity' in data) || (data.weeklyCapacity is number && data.weeklyCapacity > 0 && data.weeklyCapacity <= 168));\n    }\n\r\n    function onlyChanges(fields) {\r\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);\r\n    }\r\n\r\n    match /members/{memberId} {\r\n      allow get: if isActiveMember() || (isSignedIn() && request.auth.uid == memberId);\n      allow list: if isActiveMember();\n      allow create: if isSignedIn()\n                    && request.auth.uid == memberId\n                    && isValidMember(request.resource.data)\n                    && request.resource.data.uid == memberId\n                    && request.resource.data.role == 'member'\n                    && request.resource.data.get('disabled', false) == false;\n      allow update: if isManager() && isValidMember(request.resource.data)\n                    && request.resource.data.uid == resource.data.uid;\n      allow update: if isActiveMember() && isValidMember(request.resource.data)\n                    && request.auth.uid == memberId\n                    && request.resource.data.uid == resource.data.uid\n                    && onlyChanges(['name', 'displayName', 'theme', 'weeklyCapacityHours', 'weeklyCapacity', 'photoURL', 'fcmToken', 'leaves']);\r\n      // Keep disabled records so the same account cannot register again.\n      allow delete: if false;\n\r\n      match /notifications/{notifId} {\r\n        allow read: if isActiveMember()\n                    && (request.auth.uid == memberId || isManager());\r\n        allow create: if isActiveMember();\n        allow update: if isActiveMember() && request.auth.uid == memberId;\n        allow delete: if isActiveMember()\n                      && (request.auth.uid == memberId || isManager());\r\n      }\r\n    }\r\n\r\n    match /tasks/{taskId} {\n      function isValidTaskIdentity(data) {\n        return 'createdBy' in data && (data.createdBy == null || validUid(data.createdBy))\n          && (data.get('recurrencePreviousTaskId', null) == null || validUid(data.recurrencePreviousTaskId));\n      }\n      function validRecurrenceCreator(data) {\n        let previous = get(/databases/$(database)/documents/tasks/$(data.recurrencePreviousTaskId)).data;\n        return previous.status in ['完了', 'アーカイブ済み']\n          && previous.recurrence != null\n          && (isManager() || previous.createdBy == request.auth.uid || previous.assigneeId == request.auth.uid)\n          && data.createdBy == previous.createdBy\n          && data.recurrence == previous.recurrence\n          && data.recurrenceSourceId == (previous.get('recurrenceSourceId', null) == null ? data.recurrencePreviousTaskId : previous.recurrenceSourceId)\n          && data.title == previous.title\n          && data.assigneeId == previous.assigneeId\n          && data.parentId == previous.parentId\n          && data.estimatedHours == previous.estimatedHours\n          && data.status == '未着手';\n      }\n      function taskExistsAfterWrite() {\n        return existsAfter(/databases/$(database)/documents/tasks/$(taskId));\n      }\n      function validParent(data) {\n        return data.get('parentId', null) == null\n          || (data.parentId != taskId && existsAfter(/databases/$(database)/documents/tasks/$(data.parentId)));\n      }\n      allow read: if isActiveMember();\n      allow create: if isActiveMember() && isValidTaskIdentity(request.resource.data)\n        && !exists(/databases/$(database)/documents/taskDeletionMarkers/$(taskId))\n        && (request.resource.data.createdBy == request.auth.uid\n          || (request.resource.data.get('recurrencePreviousTaskId', null) != null && validRecurrenceCreator(request.resource.data)))\n        && validParent(request.resource.data);\n      allow update: if isActiveMember() && isValidTaskIdentity(request.resource.data)\n        && request.resource.data.createdBy == resource.data.createdBy\n        && validParent(request.resource.data);\n      // Task trees are deleted only through deleteTaskSafely, which checks every\n      // task's manager/creator/assignee and commits all record deletions atomically.\n      allow delete: if false;\n\r\n      match /comments/{commentId} {\n        allow read: if isActiveMember();\n        allow create: if isActiveMember() && taskExistsAfterWrite()\n                      && request.resource.data.authorId == request.auth.uid;\n        allow update: if isActiveMember() && taskExistsAfterWrite()\n                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);\r\n        allow delete: if isActiveMember()\n                      && resource.data.authorId == request.auth.uid;\r\n      }\r\n\r\n      match /attachments/{attachmentId} {\n        // Immutable attachment records. New files live under the author's UID.\n        function isValidAttachment(data) {\n          return data.keys().hasAll(['taskId', 'fileName', 'fileType', 'fileSize', 'dataUrl', 'storagePath', 'authorId', 'authorName', 'createdAt'])\n            && data.keys().hasOnly(['taskId', 'fileName', 'fileType', 'fileSize', 'dataUrl', 'storagePath', 'authorId', 'authorName', 'createdAt'])\n            && data.taskId == taskId\n            && data.authorId == request.auth.uid\n            && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 1024\n            && data.fileType is string && data.fileType.size() <= 256\n            && data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 10 * 1024 * 1024\n            && data.dataUrl is string && data.dataUrl.size() <= 8192\n            && data.authorName is string && data.authorName.size() <= 256\n            && data.createdAt == request.time\n            && data.storagePath is string && data.storagePath.size() <= 2048\n            && data.storagePath.split('/').size() == 4\n            && data.storagePath.split('/')[0] == 'task-attachments'\n            && data.storagePath.split('/')[1] == taskId\n            && data.storagePath.split('/')[2] == request.auth.uid\n            && data.storagePath.split('/')[3].size() > 0;\n        }\n        allow read: if isActiveMember();\n        allow create: if isActiveMember() && taskExistsAfterWrite() && isValidAttachment(request.resource.data);\n        allow delete: if isActiveMember() && resource.data.authorId == request.auth.uid;\n      }\n\n      // Legacy files have no UID in their path. Claims are verified against\n      // the original immutable attachment, and cannot be changed or deleted.\n      match /attachmentOwners/{fileName} {\n        function isValidLegacyOwner(data) {\n          let attachment = get(/databases/$(database)/documents/tasks/$(taskId)/attachments/$(data.attachmentId)).data;\n          return data.keys().hasAll(['attachmentId', 'authorId'])\n            && data.keys().hasOnly(['attachmentId', 'authorId'])\n            && data.attachmentId is string && data.attachmentId.size() > 0 && data.attachmentId.size() <= 128\n            && data.authorId == request.auth.uid\n            && attachment.authorId == request.auth.uid\n            && attachment.storagePath == 'task-attachments/' + taskId + '/' + fileName;\n        }\n        allow read: if isActiveMember();\n        allow create: if isActiveMember() && taskExistsAfterWrite() && isValidLegacyOwner(request.resource.data);\n      }\n\r\n      match /activities/{activityId} {\n        allow read: if isActiveMember();\n        allow create: if isActiveMember() && taskExistsAfterWrite() && request.resource.data.authorId == request.auth.uid;\n        allow delete: if isActiveMember();\n      }\r\n    }\n\n    // Server-only manifests and permanent markers prevent ID reuse while\n    // asynchronous cleanup still owns paths belonging to a deleted task.\n    match /taskDeletionJobs/{jobId} {\n      allow read: if isActiveMember() && (resource.data.requestedBy == request.auth.uid || isManager());\n      allow write: if false;\n    }\n    match /taskDeletionMarkers/{taskId} {\n      allow read, write: if false;\n    }\n\r\n    match /teamSettings/{docId} {\n      allow read: if isActiveMember();\n      allow write: if isManager();\r\n    }\r\n\r\n    match /taskTemplates/{templateId} {\n      function isValidTemplateIdentity(data) {\n        return 'createdBy' in data && validUid(data.createdBy);\n      }\n      allow read: if isActiveMember() && resource.data.createdBy == request.auth.uid;\n      allow create: if isActiveMember() && isValidTemplateIdentity(request.resource.data) && request.resource.data.createdBy == request.auth.uid;\n      allow update: if isActiveMember() && isValidTemplateIdentity(request.resource.data)\n        && resource.data.createdBy == request.auth.uid\n        && request.resource.data.createdBy == resource.data.createdBy;\n      allow delete: if isActiveMember() && resource.data.createdBy == request.auth.uid;\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-05T09:14:24.096383Z","metadata":{"services":["cloud.firestore"]}}
